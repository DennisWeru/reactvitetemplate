{
  "name": "vite-react-tailwind-starter",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "prepare": "husky install",
    "dev": "vite",
    "build": "npm run verify && npm run build:app",
    "verify": "npm run typecheck && npm run lint && npm run lint:sql",
    "typecheck": "tsc --noEmit && tsc --noEmit -p functions",
    "typecheck:watch": "tsc --noEmit --watch",
    "lint": "eslint --quiet src functions --ext .ts,.tsx && stylelint \"src/**/*.{less,css}\" && node scripts/check-secrets.mjs",
    "lint:fix": "eslint --quiet --fix src functions --ext .ts,.tsx && stylelint --fix \"src/**/*.{less,css}\"",
    "format": "prettier --write .",
    "dev:api": "node scripts/dev-api.mjs",
    "build:app": "vite build && npm run build:functions",
    "build:functions": "wrangler pages functions build functions --outdir dist/_worker.js --output-routes-path dist/_routes.json --compatibility-date 2025-09-01 --compatibility-flags nodejs_compat",
    "lint:sql": "node scripts/lint-migrations.mjs",
    "db:push": "node scripts/db-push.mjs",
    "db:types": "node scripts/db-types.mjs"
  },
  "dependencies": {
    "@loadable/component": "^5.15.3",
    "@radix-ui/react-popover": "^1.0.6",
    "@radix-ui/react-slot": "^1.0.2",
    "@supabase/supabase-js": "^2.117.1",
    "@tanstack/react-query": "^4.29.3",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.0.0",
    "framer-motion": "^11.1.7",
    "hono": "^4.13.9",
    "lucide-react": "^0.277.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-helmet-async": "^2.0.5",
    "react-router-dom": "^6.10.0",
    "stripe": "^18.5.0",
    "tailwind-merge": "^1.14.0",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260702.1",
    "@commitlint/cli": "^17.5.1",
    "@commitlint/config-conventional": "^17.4.4",
    "@tanstack/react-query-devtools": "^4.29.1",
    "@types/loadable__component": "^5.13.4",
    "@types/node": "^18.15.11",
    "@types/react": "^18.0.28",
    "@types/react-dom": "^18.0.11",
    "@typescript-eslint/eslint-plugin": "^5.58.0",
    "@typescript-eslint/parser": "^5.58.0",
    "@vitejs/plugin-react": "^3.1.0",
    "autoprefixer": "^10.4.14",
    "eslint": "^8.38.0",
    "eslint-config-prettier": "^8.8.0",
    "eslint-import-resolver-typescript": "^3.5.5",
    "eslint-plugin-boundaries": "^5.0.1",
    "eslint-plugin-import": "^2.27.5",
    "eslint-plugin-prettier": "^4.2.1",
    "eslint-plugin-react": "^7.32.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-unused-imports": "^2.0.0",
    "husky": "^8.0.3",
    "i18next-resources-for-ts": "1.3.2",
    "less": "^4.1.3",
    "lint-staged": "^13.2.1",
    "postcss": "^8.4.21",
    "postcss-less": "^6.0.0",
    "prettier": "^2.8.8",
    "prettier-plugin-tailwindcss": "^0.4.1",
    "stylelint": "^15.4.0",
    "stylelint-config-standard": "^32.0.0",
    "stylelint-less": "^1.0.6",
    "stylelint-prettier": "3",
    "tailwindcss": "3.3.1",
    "ts-node": "^10.9.1",
    "typescript": "^5.3.3",
    "vite": "^4.2.0",
    "vite-plugin-external": "^1.2.8",
    "vite-plugin-svgr": "^2.4.0",
    "wrangler": "^3.114.17"
  }
}
